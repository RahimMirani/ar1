# Copy this to tello/.env and fill in real values.
# tello/main.py loads tello/.env on startup; smoke scripts load it too.

# OpenAI: required for the vision module and the agent loop (Phase A + C).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: post incident JSON to this URL when the agent concludes a
# mission. Leave blank to keep notifications in-process (the dispatcher
# dashboard at /dashboard always renders them regardless of this URL).
FIREDRONE_NOTIFY_WEBHOOK=

# Optional: audio device index for sounddevice. Leave blank for default.
FIREDRONE_AUDIO_DEVICE=
